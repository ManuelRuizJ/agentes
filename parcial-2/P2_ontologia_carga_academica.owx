    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#incluyeMateria</IRI><Literal xml:lang="es">incluyeMateria</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#incluyeMateria</IRI><Literal xml:lang="es">El programa define el conjunto de materias que lo componen. Su inversa se propone funcional (una materia, un programa).</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#perteneceAPrograma</IRI><Literal xml:lang="es">perteneceAPrograma</Literal></AnnotationAssertion>
