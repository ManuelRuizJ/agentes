    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#cursaPrograma</IRI><Literal xml:lang="es">Un estudiante pertenece a un solo programa.</Literal></AnnotationAssertion>
