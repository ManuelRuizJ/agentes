    <Annotation><AnnotationProperty abbreviatedIRI="rdfs:label"/><Literal xml:lang="es">Ontologia de recomendacion personalizada de carga academica</Literal></Annotation>
    <Annotation><AnnotationProperty abbreviatedIRI="rdfs:comment"/><Literal xml:lang="es">Ontologia del proyecto Agente inteligente para la recomendacion personalizada de carga academica (Universidad Iberoamericana Puebla). Contiene unicamente clases, subclases, propiedades de objeto y propiedades de datos.</Literal></Annotation>

