    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Persona</IRI><Literal xml:lang="es">Persona</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Persona</IRI><Literal xml:lang="es">Individuo que interactua con la universidad. Raiz comun para estudiantes y profesores; evita repetir atributos como el nombre.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Estudiante</IRI><Literal xml:lang="es">Estudiante</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Estudiante</IRI><Literal xml:lang="es">Alumno de la Ibero Puebla para quien se genera la recomendacion. Concentra historial, preferencias y propuestas.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Profesor</IRI><Literal xml:lang="es">Profesor</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Profesor</IRI><Literal xml:lang="es">Docente que imparte grupos. Permite relacionar la oferta con quien la imparte.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#ProgramaAcademico</IRI><Literal xml:lang="es">ProgramaAcademico</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#ProgramaAcademico</IRI><Literal xml:lang="es">Licenciatura o plan de estudios; define que materias aplican al alumno y los creditos totales.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Materia</IRI><Literal xml:lang="es">Materia</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Materia</IRI><Literal xml:lang="es">Asignatura del catalogo con clave, creditos y relaciones de seriacion.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#MateriaObligatoria</IRI><Literal xml:lang="es">MateriaObligatoria</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#MateriaObligatoria</IRI><Literal xml:lang="es">Materia que el plan exige cursar.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#MateriaOptativa</IRI><Literal xml:lang="es">MateriaOptativa</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#MateriaOptativa</IRI><Literal xml:lang="es">Materia de libre eleccion.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Periodo</IRI><Literal xml:lang="es">Periodo</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Periodo</IRI><Literal xml:lang="es">Semestre o ciclo escolar (por ejemplo, Otono 2026) en el que se ofertan grupos y se cursan materias.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Grupo</IRI><Literal xml:lang="es">Grupo</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Grupo</IRI><Literal xml:lang="es">Oferta concreta de una materia: materia + profesor + horario + modalidad + periodo. Es lo que el alumno realmente inscribe.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#BloqueHorario</IRI><Literal xml:lang="es">BloqueHorario</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#BloqueHorario</IRI><Literal xml:lang="es">Franja de dia y hora en que se imparte un grupo.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Modalidad</IRI><Literal xml:lang="es">Modalidad</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Modalidad</IRI><Literal xml:lang="es">Forma de impartir un grupo.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#ModalidadPresencial</IRI><Literal xml:lang="es">ModalidadPresencial</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#ModalidadPresencial</IRI><Literal xml:lang="es">Clases en el campus.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#ModalidadEnLinea</IRI><Literal xml:lang="es">ModalidadEnLinea</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#ModalidadEnLinea</IRI><Literal xml:lang="es">Clases totalmente remotas.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#ModalidadHibrida</IRI><Literal xml:lang="es">ModalidadHibrida</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#ModalidadHibrida</IRI><Literal xml:lang="es">Combinacion de presencial y remoto.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#RegistroMateria</IRI><Literal xml:lang="es">RegistroMateria</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#RegistroMateria</IRI><Literal xml:lang="es">Renglon del historial academico (kardex): una materia cursada por un estudiante en un periodo.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#RegistroAprobado</IRI><Literal xml:lang="es">RegistroAprobado</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#RegistroAprobado</IRI><Literal xml:lang="es">Materia cursada y aprobada.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#RegistroReprobado</IRI><Literal xml:lang="es">RegistroReprobado</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#RegistroReprobado</IRI><Literal xml:lang="es">Materia cursada y no aprobada.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#RegistroEnCurso</IRI><Literal xml:lang="es">RegistroEnCurso</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#RegistroEnCurso</IRI><Literal xml:lang="es">Materia que el alumno cursa actualmente.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Preferencia</IRI><Literal xml:lang="es">Preferencia</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Preferencia</IRI><Literal xml:lang="es">Preferencia del alumno extraida de su lenguaje natural (por el LLM).</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#PreferenciaHorario</IRI><Literal xml:lang="es">PreferenciaHorario</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#PreferenciaHorario</IRI><Literal xml:lang="es">Preferencia sobre turno u horas (por ejemplo, clases por la tarde).</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#PreferenciaModalidad</IRI><Literal xml:lang="es">PreferenciaModalidad</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#PreferenciaModalidad</IRI><Literal xml:lang="es">Preferencia sobre presencial, en linea o hibrido.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#PreferenciaCarga</IRI><Literal xml:lang="es">PreferenciaCarga</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#PreferenciaCarga</IRI><Literal xml:lang="es">Preferencia sobre cantidad de materias o creditos (carga ligera).</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#PropuestaCarga</IRI><Literal xml:lang="es">PropuestaCarga</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#PropuestaCarga</IRI><Literal xml:lang="es">Conjunto de grupos propuesto a un alumno para un periodo, con sus puntuaciones.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#RestriccionAcademica</IRI><Literal xml:lang="es">RestriccionAcademica</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#RestriccionAcademica</IRI><Literal xml:lang="es">Regla institucional que limita las combinaciones posibles.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#RestriccionCreditos</IRI><Literal xml:lang="es">RestriccionCreditos</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#RestriccionCreditos</IRI><Literal xml:lang="es">Limite minimo y maximo de creditos por periodo.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Agente</IRI><Literal xml:lang="es">Agente</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Agente</IRI><Literal xml:lang="es">Agente de software del sistema multiagente.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AgenteHistorial</IRI><Literal xml:lang="es">AgenteHistorial</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AgenteHistorial</IRI><Literal xml:lang="es">Analista de historial y requisitos.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AgenteCarga</IRI><Literal xml:lang="es">AgenteCarga</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AgenteCarga</IRI><Literal xml:lang="es">Analista de carga academica.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AgenteHorarios</IRI><Literal xml:lang="es">AgenteHorarios</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AgenteHorarios</IRI><Literal xml:lang="es">Analista de horarios y preferencias.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AgenteManager</IRI><Literal xml:lang="es">AgenteManager</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AgenteManager</IRI><Literal xml:lang="es">Coordinador y recomendador.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#TrazaEjecucion</IRI><Literal xml:lang="es">TrazaEjecucion</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#TrazaEjecucion</IRI><Literal xml:lang="es">Evento registrado por el Trace Collector durante la ejecucion de un agente.</Literal></AnnotationAssertion>

